# macOS
.DS_Store

# Xcode (the project is generated from project.yml by XcodeGen)
*.xcodeproj/
*.xcworkspace/
DerivedData/
xcuserdata/
build/
*.xcresult/
*.ipa
*.dSYM/
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/

# Built cores, reproducible with Scripts/build-core.sh
Cores/Build/

# Local worktrees (git worktree)
.claude/worktrees/

# Games, BIOS files, firmware and keys never go into the repo (hard rule, see CLAUDE.md)
*.gba
*.gb
*.gbc
*.nds
*.dsi
*.ids
*.srl
*.nes
*.sfc
*.smc
*.iso
*.cso
*.chd
*.pbp
*.PBP
*.cue
# Freely licensed homebrew test ROMs are the only exception
!Tests/Fixtures/**
# BIOS files, firmware and keys stay ignored everywhere, Tests/Fixtures included,
# so these patterns must come after the exception
bios*.bin
scph*.bin
firmware*.bin
*.keys
keys.txt
# DS and DSi system files (melonDS) and other dumps: BIOS, firmware, NAND and SD card images
*bios*.bin
*firmware*.bin
*nand*.bin
*sd_card*.bin
*.img
*.rom
# Archives may contain games
*.zip
*.7z
*.rar
