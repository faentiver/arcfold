{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ could not be copied into the library: %@" : {
      "comment" : "Import error. The first value is a file name, the second the system's reason."
    },
    "%@ could not be read: %@" : {
      "comment" : "Import error. The first value is a file name, the second the system's reason."
    },
    "%@ does not look like a %@ game." : {
      "comment" : "Import error when the file header does not match. The first value is a file name, the second a system such as GBA or DS.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not look like a %2$@ game."
          }
        }
      }
    },
    "%@ is an encrypted DS game file. Arcfold cannot start encrypted DS games." : {
      "comment" : "Import error for a DS game file whose start is encrypted. The value is a file name."
    },
    "%@ is not a game file Arcfold can open." : {
      "comment" : "Import error for a file whose extension belongs to no system. The value is a file name."
    },
    "%@ is too large to be a %@ game." : {
      "comment" : "Import error. The first value is a file name, the second a system such as GBA or DS.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is too large to be a %2$@ game."
          }
        }
      }
    },
    "%@ is too small to be a %@ game." : {
      "comment" : "Import error. The first value is a file name, the second a system such as GBA or DS.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is too small to be a %2$@ game."
          }
        }
      }
    },
    "%@ needs a DSi. Arcfold runs DS games only." : {
      "comment" : "Import error for a game made for the DSi only. The value is a file name."
    },
    "Another game is already running. Quit it before you start this one." : {
      "comment" : "Shown instead of a second game when a game runs in another window."
    },
    "Close" : {
      "comment" : "Button that leaves a game that could not start."
    },
    "Copyright 2026 Fatih (faentiver). Source code: https://github.com/faentiver/arcfold. It includes the build recipes and scripts in Scripts/ that build the embedded cores from their sources and apply Arcfold's changes to them." : {
